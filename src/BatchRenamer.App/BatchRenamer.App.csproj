<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BatchRenamer</AssemblyName>
    <RootNamespace>BatchRenamer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BatchRenamer.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <BatchRenamerExternalVersion>1.0.0</BatchRenamerExternalVersion>
    <BatchRenamerFileVersion>1.0.0.0</BatchRenamerFileVersion>
    <Version>$(BatchRenamerExternalVersion)</Version>
    <AssemblyVersion>$(BatchRenamerFileVersion)</AssemblyVersion>
    <FileVersion>$(BatchRenamerFileVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BatchRenamerBuildFlavor)' == 'Internal'">
    <Product>BatchRenamer Internal Test</Product>
    <AssemblyTitle>BatchRenamer Internal Test</AssemblyTitle>
    <Description>easy重命名内部测试版本</Description>
    <InformationalVersion>$(BatchRenamerExternalVersion)-internal</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BatchRenamerBuildFlavor)' == 'Public'">
    <Product>easy重命名 / BatchRenamer</Product>
    <AssemblyTitle>easy重命名 / BatchRenamer</AssemblyTitle>
    <Description>安全、现代的 Windows 批量重命名工具</Description>
    <InformationalVersion>$(BatchRenamerExternalVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(BatchRenamerBuildFlavor)' != 'Internal'">
    <Compile Remove="InternalTools\**\*.cs" />
    <EmbeddedResource Remove="InternalTools\**\*" />
    <Resource Remove="InternalTools\**\*" />
    <Page Remove="InternalTools\**\*" />
    <Content Remove="InternalTools\**\*" />
    <None Remove="InternalTools\**\*" />
  </ItemGroup>

  <Target Name="ValidatePublicBuildPurityInputs"
          BeforeTargets="CoreCompile"
          Condition="'$(BatchRenamerBuildFlavor)' == 'Public'">
    <Error Condition="$([System.String]::Copy('@(Compile)').Contains('InternalTools'))" Text="Public Compile items must not contain InternalTools." />
    <Error Condition="$([System.String]::Copy('@(Resource)').Contains('InternalTools'))" Text="Public Resource items must not contain InternalTools." />
    <Error Condition="$([System.String]::Copy('@(EmbeddedResource)').Contains('InternalTools'))" Text="Public EmbeddedResource items must not contain InternalTools." />
    <Error Condition="$([System.String]::Copy('@(Page)').Contains('InternalTools'))" Text="Public Page items must not contain InternalTools." />
    <Error Condition="$([System.String]::Copy('@(Content)').Contains('InternalTools'))" Text="Public Content items must not contain InternalTools." />
    <Error Condition="$([System.String]::Copy('@(None)').Contains('InternalTools'))" Text="Public None items must not contain InternalTools." />
    <Error Condition="$([System.String]::Copy('@(ProjectReference)').Contains('InternalTools'))" Text="Public ProjectReference items must not contain InternalTools." />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\BatchRenamer.ico" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="..\BatchRenamer.Core\BatchRenamer.Core.csproj" />
    <ProjectReference Include="..\BatchRenamer.FileSystem\BatchRenamer.FileSystem.csproj" />
    <ProjectReference Include="..\BatchRenamer.Transaction\BatchRenamer.Transaction.csproj" />
  </ItemGroup>
</Project>
